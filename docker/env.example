# Template for /opt/postcrossing-tracker/.env on the dock (chmod 600, root-owned).
# Secrets and personal values live ONLY in that file (and the vault), never in git.

# This dock's mesh IP; the app is published on it only
DOCK_BIND_IP=
# Host port on the dock (pick a free one from the wiki Port Map)
PCT_HTTP_PORT=

# Generate once: echo "base64:$(openssl rand -base64 32)"
# NEVER change or lose it: contact addresses, phones and coordinates are encrypted with it.
APP_KEY=
APP_URL=https://postcards.example.org
APP_BASE_CURRENCY=USD
APP_TIMEZONE=America/New_York
APP_DATE_FORMAT=m/d/Y
APP_LOCALE=en

# MariaDB passwords: app user "postcards" and root (openssl rand -base64 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

OWNER_NAME=
OWNER_USERNAME=
# Shown to recipients on the arrival page
OWNER_LOCATION=
# Home: default "sent from" place. Private; set only here.
HOME_LAT=
HOME_LNG=

# Arrival alerts: skipped (with a logged warning) until OWNER_EMAIL and MAIL_FROM_ADDRESS are set
OWNER_EMAIL=
OWNER_CONTACT_EMAIL=
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=

# Maps: leaflet (OpenStreetMap + Nominatim, no key) or google (needs GOOGLE_API_KEY)
MAP_PROVIDER=leaflet
# Keep the User-Agent generic: no personal email, name or domain
NOMINATIM_USER_AGENT=postcard-tracker/1.0 (self-hosted)

# Provenance footer on arrival emails (fleet convention)
MAIL_PROVENANCE_FOOTER=false
MAIL_PROVENANCE_HOST=
MAIL_PROVENANCE_SOURCE=

# Optional integrations
GOOGLE_API_KEY=
AMAP_JS_KEY=
AMAP_WEB_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
